# ── Required ────────────────────────────────────────────────────────────────
# Server-side only. Never exposed to the browser. One key powers all bots.
ANTHROPIC_API_KEY=sk-ant-...

# Password for the /dashboard (HTTP Basic Auth; username is ignored).
ADMIN_PASSWORD=change-me

# ── Storage (effectively REQUIRED in production) ────────────────────────────
# Bot configs, leads, and conversations live in the store. Without Redis,
# they're stored in local JSON files — fine for local dev, but EPHEMERAL on
# Vercel (bots vanish on redeploy/idle!).
# Create a free Redis database at https://upstash.com and paste both values.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Lead notifications ──────────────────────────────────────────────────────
# The Resend API key is platform-wide; the destination email/webhook is set
# PER BOT in the dashboard. The values below are optional fallbacks used when
# a bot has no notification settings of its own.
RESEND_API_KEY=
LEAD_EMAIL_TO=
# Until you verify a domain with Resend, keep the default onboarding sender:
LEAD_EMAIL_FROM=Leads <onboarding@resend.dev>
LEAD_WEBHOOK_URL=

# ── Optional overrides ──────────────────────────────────────────────────────
# ANTHROPIC_MODEL=            # overrides bot.model for ALL bots
# DATA_DIR=                   # overrides file-store location (local dev)
