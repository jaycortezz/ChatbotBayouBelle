# ── Required ────────────────────────────────────────────────────────────────
# Server-side only. Never exposed to the browser.
ANTHROPIC_API_KEY=sk-ant-...

# Password for the /admin dashboard (HTTP Basic Auth; username is ignored).
ADMIN_PASSWORD=change-me

# ── Lead notifications (set one or both; leads are always saved regardless) ─
# Option A: email via Resend (free tier: https://resend.com)
RESEND_API_KEY=
LEAD_EMAIL_TO=owner@example.com
# Until you verify a domain with Resend, keep the default onboarding sender:
LEAD_EMAIL_FROM=Leads <onboarding@resend.dev>

# Option B: POST the lead as JSON to any URL (Zapier, Make, Slack webhook...)
LEAD_WEBHOOK_URL=

# ── Storage (recommended on Vercel) ─────────────────────────────────────────
# Without these, leads/conversations are stored in a local JSON file — fine
# for local dev, but ephemeral on Vercel (wiped on redeploy/idle).
# Create a free Redis database at https://upstash.com and paste both values.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ── Optional overrides ──────────────────────────────────────────────────────
# ANTHROPIC_MODEL=            # overrides bot.model from business-config.json
# DATA_DIR=                   # overrides file-store location
